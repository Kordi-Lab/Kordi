{
  "name": "kordi",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm dev:cloud",
    "dev:full": "pnpm dev:cloud",
    "dev:desktop": "pnpm dev:cloud",
    "dev:desktop:profile": "pnpm --dir app/desktop tauri:dev:profile",
    "dev:desktop:multi": "pnpm dev:cloud:multi",
    "reset:desktop:multi": "pnpm --dir app/desktop tauri:dev:multi:reset",
    "smoke:desktop:multi": "pnpm --dir app/desktop tauri:dev:multi:smoke",
    "dev:web": "pnpm --dir app/desktop dev",
    "preview:web": "pnpm --dir app/desktop preview",
    "prepare:sidecars": "pnpm --dir app/desktop tauri:prepare-sidecars",
    "build:desktop": "pnpm build:cloud",
    "build:web": "pnpm --dir app/desktop build",
    "run:agent": "cargo run -p kordi-cli --",
    "check:agent": "cargo check -p kordi-cli",
    "build:agent": "cargo build -p kordi-cli --release",
    "run:bridges": "cargo run --manifest-path bridges/cli/Cargo.toml --",
    "check:bridges": "cargo check --manifest-path bridges/cli/Cargo.toml",
    "build:bridges": "cargo build --manifest-path bridges/cli/Cargo.toml --release",
    "clean:worktree-targets": "node scripts/clean-inactive-worktree-targets.mjs",
    "clean:worktree-targets:delete": "node scripts/clean-inactive-worktree-targets.mjs --delete",
    "clean:debug-artifacts": "node scripts/debug-artifact-maintenance.mjs --dry-run",
    "clean:debug-artifacts:delete": "node scripts/debug-artifact-maintenance.mjs --delete",
    "release:publish-desktop": "node scripts/publish-desktop-release.mjs",
    "release:clear-desktop-acceptance": "node scripts/clear-desktop-release-channel.mjs --channel acceptance",
    "release:rollback-desktop-beta": "node scripts/rollback-desktop-beta-channel.mjs",
    "maintainability:audit": "node scripts/report-maintainability-audit.mjs",
    "maintainability:scan": "node scripts/report-overlong-files.mjs",
    "maintainability:check": "node scripts/check-maintainability-ratchet.mjs",
    "lint:suppressions:check": "node scripts/check-eslint-suppressions-ratchet.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "privacy:check": "node scripts/repository-privacy-guard.mjs",
    "lint:web": "pnpm --dir app/desktop lint",
    "typecheck:web": "pnpm --dir app/desktop typecheck",
    "lint": "pnpm lint:web",
    "dev:registry": "pnpm --dir bridges/registry dev",
    "build:registry": "pnpm --dir bridges/registry build",
    "build:rust": "cargo build --workspace",
    "check:rust": "cargo check --workspace",
    "test:rust": "cargo test --workspace",
    "check:frontend": "pnpm --dir app/desktop test:unit && pnpm --dir app/desktop typecheck && pnpm --dir app/desktop lint && pnpm --dir app/desktop build",
    "check:rust:fmt": "cargo fmt --all -- --check",
    "check:rust:clippy": "bash scripts/prepare-tauri-sidecar-placeholders.sh && cargo clippy --workspace --all-targets -- -D warnings",
    "check:rust:test:core": "cargo test -p kordi-session && cargo test -p kordi-cli --lib && cargo test -p kordi-cli desktop_runtime --no-default-features --features desktop-runtime",
    "check:rust:test:desktop": "bash scripts/prepare-tauri-sidecar-placeholders.sh && cargo test -p kordi-desktop --no-default-features",
    "check:rust:deps": "node scripts/check-desktop-dependency-surface.mjs",
    "check:rust:test": "pnpm check:rust:deps && pnpm check:rust:test:core && pnpm check:rust:test:desktop",
    "check:visual": "pnpm --dir app/desktop test:visual --project chromium",
    "check:browser": "pnpm --dir app/desktop exec playwright test -c playwright.production.config.ts --project chromium && pnpm --dir app/desktop exec playwright test -c playwright.trajectory.config.ts --project chromium",
    "check:server": "pnpm check:rust:fmt && cargo clippy --workspace --exclude kordi-desktop --all-targets -- -D warnings && cargo test -p kordi-session && cargo test -p kordi-provider --locked && cargo test -p kordi-tools read::tests --locked && cargo test -p kordi-cloud-agent-runner --locked -- --test-threads=1 && cargo test -p kordi-cli --lib && cargo test -p kordi-cli desktop_runtime --no-default-features && cargo test -p kordi-cloud-server",
    "check:migrations": "bash scripts/test-cloud-migrations.sh",
    "check:desktop": "bash scripts/prepare-tauri-sidecar-placeholders.sh && node scripts/check-desktop-dependency-surface.mjs && cargo clippy -p kordi-desktop --all-targets -- -D warnings && cargo test -p kordi-desktop --no-default-features",
    "check:ios": "xcodebuild -project app/ios/Kordi.xcodeproj -scheme 'Kordi Beta' -configuration Beta -destination 'generic/platform=iOS Simulator' -derivedDataPath .build/ios CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO build",
    "check:hygiene": "bash scripts/ci/run-hygiene.sh",
    "check:whitespace": "bash scripts/check-hygiene.sh",
    "check:english": "bash scripts/check-english-only-diff.sh",
    "select:checks": "node scripts/ci/select-checks.mjs",
    "check:ci": "node scripts/ci/select-checks.mjs --run",
    "test:ci-scripts": "node --test scripts/ci/*.test.mjs",
    "hooks:install": "bash scripts/setup-git-hooks.sh",
    "check": "pnpm lint && pnpm typecheck:web && pnpm check:rust",
    "dev:cloud": "pnpm --dir app/desktop tauri:dev:cloud",
    "dev:cloud:operator": "bash scripts/dev-cloud-operator.sh",
    "dev:cloud:remote": "bash scripts/dev-cloud-remote.sh",
    "dev:cloud:multi": "pnpm --dir app/desktop tauri:dev:multi:cloud",
    "build:cloud": "pnpm --dir app/desktop tauri:build:cloud",
    "debug:cloud:up": "bash scripts/dev-cloud-up.sh",
    "debug:cloud:oauth": "bash scripts/dev-cloud-oauth-configure.sh",
    "debug:cloud:smoke": "bash scripts/dev-cloud-smoke.sh",
    "debug:cloud:reset": "bash scripts/dev-cloud-reset.sh"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1085.0"
  }
}
