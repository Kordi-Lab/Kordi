<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>ai.kordi.nearby.refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(KORDI_APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(KORDI_OAUTH_CALLBACK_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>KordiCloudBaseURL</key>
	<string>$(KORDI_CLOUD_BASE_URL)</string>
	<key>KordiDistributionChannel</key>
	<string>$(KORDI_DISTRIBUTION_CHANNEL)</string>
	<key>KordiHostAppURLScheme</key>
	<string>$(KORDI_OAUTH_CALLBACK_SCHEME)</string>
	<key>KordiOAuthCallbackScheme</key>
	<string>$(KORDI_OAUTH_CALLBACK_SCHEME)</string>
	<key>KordiShareAppGroup</key>
	<string>$(KORDI_SHARE_APP_GROUP)</string>
	<key>KordiShareCredentialService</key>
	<string>$(KORDI_SHARE_CREDENTIAL_SERVICE)</string>
	<key>KordiShareKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)$(KORDI_SHARE_CREDENTIAL_SERVICE)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_kordi-cg._tcp</string>
		<string>_kordi-cg._udp</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Kordi reads calendar events for your private Digest and, if you choose, to build your Grounding card. It does not send invitations or change events.</string>
	<key>NSCameraUsageDescription</key>
	<string>Kordi uses the camera when you record a video message, attach a photo, join a video call, or scan a Grounding pairing code.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Kordi uses the local network to establish audio and video calls when required, and to pair Grounding cards with phones nearby.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>With background alerts on, Kordi checks your location so it can tell you when someone you're looking for is nearby.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Kordi shows people near you who also turned on Nearby.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Kordi uses the microphone when you record a voice or video message or join a call.</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>Kordi uses nearby devices to pair Grounding cards when two phones are held together.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Kordi saves Live Photos you choose to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Kordi shows your photo library when you choose images to send in a conversation.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>If you choose, Kordi reads reminder titles to build your Grounding card. It does not change reminders.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Kordi transcribes voice messages on this iPhone so people and agents can read them.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>KordiLaunchMark</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
