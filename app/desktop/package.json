{
  "name": "kordi-desktop",
  "private": true,
  "version": "0.0.1-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build && pnpm check:bundle",
    "check:bundle": "node scripts/check-js-chunk-budget.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/*.test.tsx",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri:refresh-icon": "swift scripts/reshape-mac-icon.swift",
    "tauri:prepare-sidecars": "node scripts/prepare-sidecars.mjs",
    "tauri:dev": "pnpm tauri:prepare-sidecars && tauri dev",
    "tauri:dev:profile": "node scripts/tauri-dev-profile.mjs",
    "tauri:dev:instance": "node scripts/tauri-dev-instance.mjs",
    "tauri:dev:multi": "node scripts/multi-instance/launch.mjs",
    "tauri:dev:multi:cloud": "node scripts/launch-cloud-multi.mjs",
    "tauri:dev:multi:prepare": "node scripts/multi-instance/prepare-env.mjs",
    "tauri:dev:multi:reset": "node scripts/multi-instance/reset.mjs",
    "tauri:dev:multi:smoke": "node scripts/multi-instance/smoke.mjs",
    "release:secret-guard": "node scripts/assert-no-release-secrets.mjs",
    "release:verify-cloud-dmg": "node scripts/assert-macos-dmg-release.mjs --app-name 'Kordi Cloud'",
    "tauri:build": "pnpm release:secret-guard && pnpm tauri:prepare-sidecars && tauri build",
    "tauri:build:cloud": "pnpm release:secret-guard && VITE_KORDI_EDITION=cloud KORDI_EDITION=cloud pnpm tauri:prepare-sidecars && VITE_KORDI_EDITION=cloud KORDI_EDITION=cloud tauri build --config src-tauri/tauri.cloud.conf.json",
    "tauri:build:cloud:dmg": "pnpm release:secret-guard && VITE_KORDI_EDITION=cloud KORDI_EDITION=cloud pnpm tauri:prepare-sidecars && VITE_KORDI_EDITION=cloud KORDI_EDITION=cloud tauri build --config src-tauri/tauri.cloud.conf.json --bundles dmg && pnpm release:verify-cloud-dmg"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2.8.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "vite": "^8.0.4",
    "yaml": "^2.8.3"
  }
}
