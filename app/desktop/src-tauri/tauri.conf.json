{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kordi",
  "version": "0.0.2-beta.3",
  "identifier": "io.kordi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && npm run tauri:prepare-sidecars",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Kordi",
        "width": 1480,
        "height": 980,
        "minWidth": 1192,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "backgroundThrottling": "disabled",
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        },
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 8,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "data:",
          "blob:",
          "https:",
          "http://127.0.0.1:17081",
          "http://127.0.0.1:18181"
        ],
        "media-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:",
          "data:",
          "https://kordi.ai",
          "http://127.0.0.1:17081",
          "http://127.0.0.1:18181"
        ],
        "font-src": ["'self'", "data:"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "asset:",
          "http://asset.localhost",
          "data:",
          "blob:",
          "https://kordi.ai",
          "wss://kordi.ai",
          "wss:",
          "http://127.0.0.1:17081",
          "ws://127.0.0.1:17081",
          "http://127.0.0.1:18181",
          "ws://127.0.0.1:18181"
        ],
        "worker-src": ["'self'", "blob:"],
        "frame-src": [
          "'self'",
          "about:",
          "kordi-artifact-preview:",
          "http://kordi-artifact-preview.localhost"
        ],
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./Entitlements.plist"
    },
    "externalBin": [
      "binaries/kordi"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3N0JBRkMwRDRDNzFEOUIKUldTYkhjZlV3Szk3WjVXWWVmNzZGanNDakFlRkxTZ3UwZ1dLelpJenl3NnY3YmkvZCtEcUxxUWcK",
      "endpoints": [
        "https://kordi.ai/updates/desktop/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
