{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kordi",
  "version": "0.0.1-beta.3",
  "identifier": "io.kordi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && npm run tauri:prepare-sidecars",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kordi",
        "width": 1480,
        "height": 980,
        "minWidth": 1192,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 8,
          "y": 14
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "externalBin": [
      "binaries/kordi",
      "binaries/bridges"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://coordinar.io/api/desktop-updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "31yh7ByPZ6fCnMpLZPQ+PzwNsojhr/2gauXDroqMUtE="
    }
  }
}
