{
  "version": 1,
  "defaultPool": "shared",
  "pools": [
    {
      "id": "shared",
      "systemAgent": {
        "provider": "openai-compatible",
        "baseUrl": "https://llm.example.test/v1",
        "model": "example-model",
        "apiKeyEnv": "KORDI_POOL_SHARED_API_KEY",
        "headers": {
          "HTTP-Referer": "https://app.example.test",
          "X-Title": "Example"
        }
      },
      "limits": {
        "systemAgentRunsPerConversationPerDay": 3,
        "groundingRunsPerPersonPerDay": "unlimited"
      }
    },
    {
      "id": "team-example",
      "systemAgent": {
        "provider": "openai-compatible",
        "baseUrl": "https://llm.example.test/v1",
        "model": "example-large-model",
        "apiKeyEnv": "KORDI_POOL_TEAM_EXAMPLE_API_KEY",
        "estimatedCostMicrosPerRun": 2000
      },
      "grounding": {
        "provider": "openai-compatible",
        "baseUrl": "https://llm.example.test/v1",
        "model": "example-small-model",
        "apiKeyEnv": "KORDI_POOL_TEAM_EXAMPLE_API_KEY",
        "estimatedCostMicrosPerRun": 500
      },
      "limits": {
        "systemAgentRunsPerConversationPerDay": 7,
        "groundingRunsPerPersonPerDay": 5,
        "poolRunsPerDay": 100,
        "poolSpendMicrosPerDay": 1000000
      },
      "stopped": false,
      "organizations": ["org_00000000000000000000000000000001"]
    }
  ]
}
