<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.kordi.github-actions-runner</string>
  <key>UserName</key>
  <string>kordi-ci</string>
  <key>GroupName</key>
  <string>kordi-ci</string>
  <key>WorkingDirectory</key>
  <string>/Users/kordi-ci/actions-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/kordi-ci/actions-runner/runsvc.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ACTIONS_RUNNER_SVC</key>
    <string>1</string>
    <key>HOME</key>
    <string>/Users/kordi-ci</string>
    <key>PATH</key>
    <string>/Users/kordi-ci/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>SessionCreate</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/kordi-ci/Library/Logs/KordiCI/runner.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kordi-ci/Library/Logs/KordiCI/runner.stderr.log</string>
</dict>
</plist>
