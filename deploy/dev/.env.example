# Copying this file directly is intentionally insufficient. Use
# `pnpm debug:cloud:up` to create deploy/dev/.env with random local secrets.
KORDI_DEBUG_API_PORT=17081
KORDI_DEBUG_MINIO_PORT=19000
KORDI_DEBUG_MINIO_CONSOLE_PORT=19001
POSTGRES_PASSWORD=<generated-by-debug-helper>
REDIS_PASSWORD=<generated-by-debug-helper>
MINIO_ROOT_USER=kordi-debug
MINIO_ROOT_PASSWORD=<generated-by-debug-helper>
KORDI_CLOUD_PROVIDER_AUTH_ENCRYPTION_KEY=<generated-by-debug-helper>
KORDI_CLOUD_RUNNER_TOKEN=<generated-by-debug-helper>
KORDI_CHAT_SYNC_CURSOR_SECRET=<generated-by-debug-helper>
# Optional developer-owned OAuth apps. Never reuse production values.
KORDI_OAUTH_GITHUB_CLIENT_ID=
KORDI_OAUTH_GITHUB_CLIENT_SECRET=
KORDI_OAUTH_GOOGLE_CLIENT_ID=
KORDI_OAUTH_GOOGLE_CLIENT_SECRET=
# Optional developer-owned calling services. Never reuse product credentials.
KORDI_LIVEKIT_URL=
KORDI_LIVEKIT_API_KEY=
KORDI_LIVEKIT_API_SECRET=
KORDI_APNS_ENVIRONMENT=
KORDI_APNS_KEY_ID=
KORDI_APNS_TEAM_ID=
KORDI_APNS_PRIVATE_KEY_BASE64=
KORDI_APNS_BUNDLE_ID=
