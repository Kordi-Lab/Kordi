# Build inside the same Debian release used by the runtime image. Building the
# runner directly on the deployment VM can link it against a newer glibc than
# bookworm provides, causing a crash loop before the process reaches main().
FROM docker.io/library/rust:1.97-slim-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY agent ./agent
COPY app ./app
COPY bridges ./bridges
COPY shared ./shared

RUN cargo build --release -p kordi-cloud-agent-runner

FROM docker.io/library/debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/v1.30.0/bin/linux/amd64/kubectl" \
    && chmod +x /usr/local/bin/kubectl \
    && rm -rf /var/lib/apt/lists/*

# Commands of the development-only local sandbox backend run as this
# unprivileged user when the runner is root, so they cannot read the runner's
# environment. The runner itself stays root to switch to it.
RUN groupadd --system --gid 10001 kordi-sandbox \
    && useradd --system --uid 10001 --gid 10001 --no-create-home \
       --home-dir /nonexistent --shell /usr/sbin/nologin kordi-sandbox

COPY --from=builder /workspace/target/release/kordi-cloud-agent-runner /usr/local/bin/kordi-cloud-agent-runner

ENTRYPOINT ["/usr/local/bin/kordi-cloud-agent-runner"]
