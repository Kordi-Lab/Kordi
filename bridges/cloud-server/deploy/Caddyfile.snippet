# Complete Kordi product edge configuration.
#
# The canonical origin serves the public website, beta intake, Cloud API,
# WebSocket, health, and updater routes. The legacy origin keeps product routes
# available for already-released desktop clients and redirects only ordinary
# browser navigation to the canonical site.
#
# The loopback-only Kubernetes NodePort follows ready Service endpoints without
# a long-running kubectl transport process or an embedded cluster IP.

kordi.ai, www.kordi.ai {
	encode zstd gzip
	root * /srv/kordi-homepage/current

	@cloud_product_routes path /v1/cloud/* /health /updates/*
	handle @cloud_product_routes {
		reverse_proxy 127.0.0.1:30081 {
			header_up X-Real-IP {remote_host}
			lb_try_duration 5s
			lb_try_interval 100ms
			transport http {
				keepalive off
			}
		}
	}

	@call_media path /rtc /rtc/*
	handle @call_media {
		reverse_proxy 127.0.0.1:7880
	}

	handle /beta-api/* {
		reverse_proxy 127.0.0.1:17181
	}

	handle /index.html {
		redir * / 308
	}
	handle /research.html {
		redir * /research 308
	}
	handle /about.html {
		redir * /about 308
	}
	handle /privacy.html {
		redir * /privacy 308
	}
	handle /terms.html {
		redir * /terms 308
	}

	handle /research/ {
		redir * /research 308
	}
	handle /about/ {
		redir * /about 308
	}
	handle /privacy/ {
		redir * /privacy 308
	}
	handle /terms/ {
		redir * /terms 308
	}

	handle / {
		rewrite * /index.html
		file_server
	}
	handle /research {
		rewrite * /research.html
		file_server
	}
	handle /about {
		rewrite * /about.html
		file_server
	}
	handle /privacy {
		rewrite * /privacy.html
		file_server
	}
	handle /terms {
		rewrite * /terms.html
		file_server
	}

	@homepage_assets path /styles.css /app.js /assets/*
	handle @homepage_assets {
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:30081 {
			header_up X-Real-IP {remote_host}
			lb_try_duration 5s
			lb_try_interval 100ms
			transport http {
				keepalive off
			}
		}
	}
}

coordinar.io, www.coordinar.io {
	encode zstd gzip

	@legacy_product_routes path /v1/cloud/* /v2/chat/* /health /updates/*
	handle @legacy_product_routes {
		reverse_proxy 127.0.0.1:30081 {
			header_up X-Real-IP {remote_host}
			lb_try_duration 5s
			lb_try_interval 100ms
			transport http {
				keepalive off
			}
		}
	}

	handle {
		redir https://kordi.ai{uri} 308
	}
}
