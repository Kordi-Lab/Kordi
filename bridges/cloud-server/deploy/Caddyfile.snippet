# Complete Kordi product edge configuration.
#
# The product origin serves the public website, beta intake, Cloud API,
# WebSocket, health, and updater routes.
#
# The loopback-only Kubernetes NodePort follows ready Service endpoints without
# a long-running kubectl transport process or an embedded cluster IP. Port 8080
# is the private origin for the edge proxy in front of this host and must
# accept traffic only from that proxy.
#
# Sign-in rate limits, login lockouts, and audit records key on the client
# address that this file forwards in X-Real-IP. Only the edge proxy may name
# the client, so the :8080 server trusts only the operator's proxy ranges and
# parses the client-IP header strictly. Every other peer is treated as the
# client itself. This needs Caddy 2.7 or newer.
#
# Set these in the caddy service environment, never in this file:
#   KORDI_TRUSTED_PROXIES   Space-separated CIDR ranges of the edge proxy.
#                           Defaults to the ranges of the original load
#                           balancer. A proxy that connects through a local
#                           connector uses 127.0.0.1/32 ::1/128.
#   KORDI_CLIENT_IP_HEADER  The header that proxy writes the client address
#                           to. Defaults to X-Forwarded-For.
#   KORDI_EDGE_LB_ADDRESS   Optional extra proxy address, added to the list.
#
# Leave a setting unset, never empty, to use its default. An empty
# KORDI_TRUSTED_PROXIES still validates but trusts no proxy, so every client
# shares the proxy's address in rate limits and lockouts.

{
	servers :8080 {
		trusted_proxies static {$KORDI_TRUSTED_PROXIES:130.211.0.0/22 35.191.0.0/16} {$KORDI_EDGE_LB_ADDRESS}
		client_ip_headers {$KORDI_CLIENT_IP_HEADER:X-Forwarded-For}
		trusted_proxies_strict
	}
}

(kordi_product_site) {
	encode zstd gzip
	root * /srv/kordi-homepage/current

	@cloud_product_routes path /v1/cloud/* /assets/blob-emoji/* /health /updates/*
	handle @cloud_product_routes {
		reverse_proxy 127.0.0.1:30081 {
			header_up X-Real-IP {client_ip}
			lb_try_duration 5s
			lb_try_interval 100ms
			transport http {
				keepalive off
			}
		}
	}

	@call_media path /rtc /rtc/*
	handle @call_media {
		reverse_proxy 127.0.0.1:7880
	}

	handle /beta-api/* {
		reverse_proxy 127.0.0.1:17181
	}

	handle /index.html {
		redir * / 308
	}
	handle /research.html {
		redir * /research 308
	}
	handle /about.html {
		redir * /about 308
	}
	handle /iphone.html {
		redir * /iphone 308
	}
	handle /privacy.html {
		redir * /privacy 308
	}
	handle /terms.html {
		redir * /terms 308
	}

	handle /research/ {
		redir * /research 308
	}
	handle /about/ {
		redir * /about 308
	}
	handle /iphone/ {
		redir * /iphone 308
	}
	handle /privacy/ {
		redir * /privacy 308
	}
	handle /terms/ {
		redir * /terms 308
	}

	handle / {
		rewrite * /index.html
		file_server
	}
	handle /research {
		rewrite * /research.html
		file_server
	}
	handle /about {
		rewrite * /about.html
		file_server
	}
	handle /iphone {
		rewrite * /iphone.html
		file_server
	}
	handle /privacy {
		rewrite * /privacy.html
		file_server
	}
	handle /terms {
		rewrite * /terms.html
		file_server
	}

	@homepage_assets path /styles.css /app.js /assets/*
	handle @homepage_assets {
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:30081 {
			header_up X-Real-IP {client_ip}
			lb_try_duration 5s
			lb_try_interval 100ms
			transport http {
				keepalive off
			}
		}
	}
}

kordi.ai, www.kordi.ai {
	import kordi_product_site
}

:8080 {
	import kordi_product_site
}
