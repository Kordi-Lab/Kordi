{
  "version": 1,
  "groups": [
    {
      "id": "frontend",
      "title": "Frontend",
      "workflow": "ci-frontend.yml",
      "command": "pnpm check:frontend",
      "runner": "ubuntu-latest",
      "prerequisites": ["node", "pnpm"],
      "paths": [
        "app/desktop/**",
        "shared/blob-emoji/**",
        "shared/noto-emoji/**",
        "shared/digest/**",
        "shared/agent-targeting/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ],
      "always": false,
      "serial": false,
      "timeoutMinutes": 30,
      "outputs": ["unit tests", "typecheck", "lint", "web build"]
    },
    {
      "id": "visual",
      "title": "Visual regression",
      "workflow": "ci-visual.yml",
      "command": "pnpm check:visual",
      "runner": "macos-15",
      "prerequisites": ["node", "pnpm", "playwright-chromium"],
      "paths": [
        "app/desktop/src/**",
        "app/desktop/tests/visual/**",
        "app/desktop/public/**",
        "app/desktop/index.html",
        "app/desktop/vite.config.js",
        "app/desktop/vite.trajectory.config.js",
        "app/desktop/playwright.visual.config.ts",
        "app/desktop/package.json",
        "shared/blob-emoji/**",
        "shared/noto-emoji/**",
        "pnpm-lock.yaml"
      ],
      "always": false,
      "serial": false,
      "timeoutMinutes": 30,
      "outputs": ["chromium screenshot comparison"]
    },
    {
      "id": "browser",
      "title": "Browser entrypoints",
      "workflow": "ci-visual.yml",
      "command": "pnpm check:browser",
      "runner": "macos-15",
      "prerequisites": ["node", "pnpm", "playwright-chromium"],
      "paths": [
        "app/desktop/src/**",
        "app/desktop/tests/production/**",
        "app/desktop/tests/visual/**",
        "app/desktop/index.html",
        "app/desktop/vite.config.js",
        "app/desktop/vite.trajectory.config.js",
        "app/desktop/playwright.production.config.ts",
        "app/desktop/playwright.trajectory.config.ts",
        "app/desktop/package.json",
        "shared/blob-emoji/**",
        "shared/noto-emoji/**",
        "shared/digest/**",
        "shared/agent-targeting/**",
        "pnpm-lock.yaml"
      ],
      "always": false,
      "serial": false,
      "timeoutMinutes": 30,
      "outputs": ["production entrypoint checks", "transcript trajectory checks"]
    },
    {
      "id": "server",
      "title": "Server and core Rust",
      "workflow": "ci-rust.yml",
      "command": "pnpm check:server",
      "runner": "ubuntu-latest",
      "prerequisites": ["cargo"],
      "paths": [
        "agent/**",
        "app/server/**",
        "bridges/cli/**",
        "bridges/cloud-agent-runner/**",
        "bridges/cloud-server/**",
        "bridges/cloud-temporal-bridge/**",
        "bridges/Cargo.toml",
        "shared/rust/**",
        "shared/blob-emoji/**",
        "shared/chat-sync/**",
        "shared/agent-targeting/**",
        "shared/artifacts/**",
        "shared/public-only/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "always": false,
      "serial": false,
      "timeoutMinutes": 60,
      "outputs": [
        "rustfmt",
        "clippy",
        "session tests",
        "provider tests",
        "tools tests",
        "cloud agent runner tests",
        "CLI lib tests",
        "desktop-runtime tests",
        "cloud server tests"
      ]
    },
    {
      "id": "migrations",
      "title": "Database migrations",
      "workflow": "ci-rust.yml",
      "command": "pnpm check:migrations",
      "runner": "ubuntu-latest",
      "prerequisites": ["cargo", "postgres"],
      "paths": [
        "bridges/cloud-server/**",
        "bridges/cloud-agent-runner/**",
        "agent/crates/tools/**",
        "shared/blob-emoji/**",
        "shared/chat-sync/**",
        "shared/agent-targeting/**",
        "shared/artifacts/**",
        "shared/public-only/**",
        "Cargo.toml",
        "Cargo.lock",
        "scripts/test-cloud-migrations.sh",
        "scripts/prepare-ci-postgres.sh",
        "scripts/lib/native-migration-postgres.sh"
      ],
      "always": false,
      "serial": false,
      "timeoutMinutes": 45,
      "outputs": ["database upgrade matrix", "cloud agent runtime e2e", "chat sync e2e"]
    },
    {
      "id": "desktop",
      "title": "Desktop (macOS/Tauri)",
      "workflow": "ci-platforms.yml",
      "command": "pnpm check:desktop",
      "runner": "macos-15",
      "prerequisites": ["cargo", "xcode"],
      "paths": [
        "app/desktop/src-tauri/**",
        "agent/**",
        "shared/rust/**",
        "shared/agent-targeting/**",
        "shared/artifacts/**",
        "shared/blob-emoji/**",
        "shared/chat-sync/**",
        "shared/public-only/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "always": false,
      "serial": false,
      "timeoutMinutes": 45,
      "outputs": ["Tauri dependency surface", "Tauri clippy", "Tauri crate tests"]
    },
    {
      "id": "ios",
      "title": "iOS simulator compilation",
      "workflow": "ci-platforms.yml",
      "command": "pnpm check:ios",
      "runner": "xcode-27",
      "prerequisites": ["xcode"],
      "paths": [
        "app/ios/**",
        "shared/digest/**",
        "shared/agent-targeting/**",
        "app/desktop/src-tauri/native/LivePhotos.swift",
        "app/desktop/tests/livePhotoNativeCheck.swift",
        "scripts/prepare-live-photo-test-assets.sh"
      ],
      "always": false,
      "serial": false,
      "timeoutMinutes": 45,
      "outputs": ["unsigned iOS simulator compilation"]
    },
    {
      "id": "hygiene",
      "title": "Repository hygiene",
      "workflow": "ci-hygiene.yml",
      "command": "pnpm check:hygiene",
      "runner": "ubuntu-latest",
      "prerequisites": ["node", "pnpm", "git"],
      "paths": [],
      "always": true,
      "serial": false,
      "timeoutMinutes": 15,
      "outputs": [
        "privacy baseline",
        "whitespace",
        "maintainability ratchet",
        "eslint suppression ratchet",
        "script tests"
      ]
    }
  ]
}
